# Copy to .env and fill in. Never commit .env.

# SQLite by default; use Postgres in production:
# DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs
DATABASE_URL=sqlite:///jobs.db

# role@region pairs, separated by ;  (tech companies mostly title roles "Software Engineer")
# After changing this, run: python -m pipeline.run --rematch
TRACKED_SEARCHES=data analyst@Alberta;software developer@Alberta;software engineer@Alberta

# ---- Quota-limited APIs: each runs only if its key is set, under a request budget ----
# JSearch (https://www.openwebninja.com/api/jsearch): 200 requests/month free.
# One request per tracked search per run: 2 searches x ~30 days = ~60/month.
JSEARCH_API_KEY=
JSEARCH_PROVIDER=openwebninja          # or rapidapi, if your key came from RapidAPI
JSEARCH_MONTHLY_LIMIT=200
JSEARCH_MAX_PER_RUN=4
JSEARCH_DATE_POSTED=3days              # overlap so a missed day doesn't leave a gap

# Jobven (https://jobven.com): employer career pages, incl. Workday sites the boards below miss.
# Billed per job *record* returned, not per request: 300 records/month free (2,500 in the
# first 7 days). One combined query per run, synced incrementally, at most MAX_PER_RUN records.
JOBVEN_API_KEY=
JOBVEN_MONTHLY_LIMIT=300
JOBVEN_MAX_PER_RUN=10                  # x ~30 daily runs = ~300/month
JOBVEN_LOOKBACK_DAYS=7                 # first sync only; later runs resume where the last stopped

# Jooble: 500 requests for the key's whole lifetime. Leave blank to keep it off.
JOOBLE_API_KEY=
JOOBLE_LIFETIME_LIMIT=500
JOOBLE_MAX_PER_RUN=2

# Adzuna: ~25 free calls total. Leave blank to keep it off.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_LIFETIME_LIMIT=25

# ---- API (uvicorn api.main:app) ----
# Read-only connection for the public API: create the role with sql/api_reader.sql, then use
# DATABASE_URL with api_reader's user and password. Unset = falls back to DATABASE_URL (dev only).
API_DATABASE_URL=
# Browser origins allowed to call the API, comma-separated (default: local Vite/Next dev servers)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Unlimited public company job boards (comma-separated) ----
# Verified Oct 2026 to have Alberta postings. Most large Alberta employers (energy, banks,
# airlines) use Workday, which has no public board API, so they come in via JSearch instead.
GREENHOUSE_BOARDS=orennia,stackadapt                 # boards.greenhouse.io/<token>
LEVER_COMPANIES=altaml                               # jobs.lever.co/<company>
ASHBY_BOARDS=jobber,benevity,neofinancial,absorblms,zayzoon,lightspeedhq,cohere  # jobs.ashbyhq.com/<board>
SMARTRECRUITERS_COMPANIES=                           # none found in Alberta yet
